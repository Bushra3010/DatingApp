# Leave DATABASE_URL unset to use embedded Postgres (PGlite) stored in ./.data/pglite.
# Use "memory://" for a throwaway in-memory database, or a postgres:// URL in production.
# DATABASE_URL=postgres://kindred:kindred@localhost:5432/kindred
PORT=3000
JWT_SECRET=change-me-in-production
# console = print OTP codes to the server log; the dev code 000000 is accepted when OTP_DEV_BYPASS=true.
SMS_PROVIDER=console
OTP_DEV_BYPASS=true
# Moderation and verification providers. "auto" approves everything (dev only).
MODERATION_PROVIDER=auto
VERIFICATION_PROVIDER=auto
MEDIA_DIR=./.data/media
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_TOKEN=change-me-admin
FREE_DAILY_LIKES=8
